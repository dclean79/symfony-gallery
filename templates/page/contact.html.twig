{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block body %}
    <h1 class="display-4 mb-4" style="color: #155263;">{{ page_title }}</h1>

    <p class="lead">
        If you have questions about this demo application or would like to learn more
        about the capabilities of Symfony and Bootstrap, please feel free to contact us.
    </p>

    <div class="card mb-3 shadow-sm border-0" style="background-color: #ffc93c;">
        <div class="card-body">
            <h5 class="card-title" style="color: #0c2f39;">E-mail Address</h5>
            <p class="card-text">
                <i class="bi bi-envelope-fill me-2"></i> contact@example.com
            </p>
        </div>
    </div>

    <div class="card mb-3 shadow-sm border-0" style="background-color: #ffd76f;">
        <div class="card-body">
            <h5 class="card-title" style="color: #0c2f39;">Phone Number</h5>
            <p class="card-text">
                <i class="bi bi-phone-fill me-2"></i> +48 123 456 789
            </p>
        </div>
    </div>

    <p class="mt-4 small text-muted">Note: This is a demonstration application. The contact details are fictitious.</p>
{% endblock %}