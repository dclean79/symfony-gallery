{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block body %}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>{{ page_title }}</h1>
        <a href="{{ path('app_gallery_new') }}" class="btn btn-warning" style="background-color: #ffc93c; border-color: #ffc93c; color: #0c2f39;">
            <i class="bi bi-folder-plus"></i> Add Gallery
        </a>
    </div>
    
    <h2>Existing Galleries:</h2>
    
    {% if galleries is empty %}
        <div class="alert alert-info">No galleries found yet. Start by clicking "Add Gallery"!</div>
    {% else %}
        {# Główny kontener akordeonu (dla data-bs-parent) #}
        <div class="accordion" id="accordionGalleries">
            {% for galleryData in galleries %}

                {% set slug = galleryData.slug %}
                {% set pictures = galleryData.pictures is defined ? galleryData.pictures : [] %} {# Zakładamy, że to jest tablica zdjęć #}
                {% set collapseId = 'collapse-' ~ slug %}

                <div class="accordion-item">
                    <h2 class="accordion-header" id="heading-{{ slug }}">
                        <button class="accordion-button collapsed" type="button" 
                                data-bs-toggle="collapse" 
                                data-bs-target="#{{ collapseId }}" 
                                aria-expanded="false" 
                                aria-controls="{{ collapseId }}">
                            {{ slug |capitalize|replace({'-': ' '}) }} ({{ pictures|length }} Pictures)
                        </button>
                    </h2>
                    
                    <div id="{{ collapseId }}" class="accordion-collapse collapse" 
                         data-bs-parent="#accordionGalleries">
                        <div class="accordion-body">
                            
                            {# Użycie Bootstrap Grid: 10/12 dla miniaturek, 2/12 dla przycisku #}
                            <div class="row">
                                
                                {# KOLUMNA 10 (Miniaturki Zdjęć) #}
                                <div class="col-10 d-flex flex-wrap align-items-center">
                                    {% if pictures is not empty %}
                                        {% for picture in pictures|slice(0, 5) %} {# Ograniczamy do 5, by nie zaśmiecać widoku #}
                                            <div style="padding: 5px;">
                                                <img src="{{ '/uploads/galleries/' ~ slug ~ '/' ~ picture.filename }}" {# Dostosuj ścieżkę do struktury swojego obiektu #}
                                                    alt="{{ slug }} picture"
                                                    class="img-thumbnail"
                                                    style="width: 150px; height: 150px; object-fit: cover;">
                                            </div>
                                        {% endfor %}
                                    {% else %}
                                        <p class="text-muted">No pictures uploaded yet.</p>
                                    {% endif %}
                                </div>
                                
                                {# KOLUMNA 2 (Przycisk Akcji) #}
                                <div class="col-2 d-flex justify-content-end align-items-center">
                                    <a href="{{ path('app_gallery_upload', {'slug': slug }) }}" class="btn btn-sm btn-info text-nowrap" 
                                    style="background-color: #1e758d; border-color: #1e758d; color: white;">
                                        <i class="bi bi-image"></i> Add Pictures
                                    </a>
                                </div>
                                
                            </div> {# Koniec row #}
                            
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

{% endblock %}