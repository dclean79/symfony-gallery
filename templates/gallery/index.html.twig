{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block body %}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>{{ page_title }}</h1>
        <a href="{{ path('app_gallery_new') }}" class="btn btn-warning" style="background-color: #ffc93c; border-color: #ffc93c; color: #0c2f39;">
            <i class="bi bi-folder-plus"></i> Add Gallery
        </a>
    </div>
    
    <h2>Existing Galleries:</h2>
    
   {% if galleries is empty %}
        <div class="alert alert-info">No galleries found yet. Start by clicking "Add Gallery"!</div>
    {% else %}
        <div class="accordion" id="accordionGalleries">
            {% for galleryData in galleries %}

                {% set slug = galleryData.slug %}
                {% set pictures = galleryData.pictures is defined ? galleryData.pictures : [] %}
                {% set collapseId = 'collapse-' ~ slug %}

                <div class="accordion-item">
                    <h2 class="accordion-header" id="heading-{{ slug }}">
                        <button class="accordion-button collapsed" type="button" 
                                data-bs-toggle="collapse" 
                                data-bs-target="#{{ collapseId }}" 
                                aria-expanded="false" 
                                aria-controls="{{ collapseId }}">
                            {{ slug |capitalize|replace({'-': ' '}) }} ({{ pictures|length }} Pictures)
                        </button>
                    </h2>
                    
                    <div id="{{ collapseId }}" 
                         class="accordion-collapse collapse" 
                         data-bs-parent="#accordionGalleries"
                         data-gallery-slug="{{ slug }}"
                         data-gallery-pictures="{{ pictures|json_encode() }}">
                         
                        <div class="accordion-body">
                            
                            <div class="row">
                               
                                <div class="col-10 d-flex flex-wrap align-items-center">
                                    {% if pictures is not empty %}
                                        {% for picture in pictures %}
                                            <a href="#" 
                                               class="d-block" 
                                               data-bs-toggle="modal" 
                                               data-bs-target="#galleryCarouselModal"
                                               data-index="{{ loop.index0 }}"  
                                               style="padding: 5px;">
                                                
                                                <img src="{{ '/uploads/galleries/' ~ slug ~ '/' ~ picture.filename }}"
                                                    alt="{{ slug }} picture"
                                                    class="img-thumbnail"
                                                    style="width: 150px; height: 150px; object-fit: cover;">
                                            </a>
                                        {% endfor %}
                                    {% else %}
                                        <p class="text-muted">No pictures uploaded yet.</p>
                                    {% endif %}
                                </div>
                                
                                <div class="col-2 d-flex justify-content-end align-items-center">
                                    <a href="{{ path('app_gallery_upload', {'slug': slug }) }}" class="btn btn-sm btn-info text-nowrap" 
                                    style="background-color: #1e758d; border-color: #1e758d; color: white;">
                                        <i class="bi bi-image"></i> Add Pictures
                                    </a>
                                </div>
                                
                            </div>
                            
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <div class="modal fade" id="galleryCarouselModal" tabindex="-1" aria-labelledby="galleryCarouselModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content bg-dark">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-white" id="galleryCarouselModalLabel">Gallery View</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0">
                    <div id="imageCarousel" class="carousel slide" data-bs-ride="false" data-bs-interval="false">
                        <div class="carousel-inner" id="carousel-inner-content">
                            {# slides will inject here via JavaScript #}
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#imageCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#imageCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modal = document.getElementById('galleryCarouselModal');
            const carouselInner = document.getElementById('carousel-inner-content');
            const imageCarousel = document.getElementById('imageCarousel');
            
            modal.addEventListener('show.bs.modal', function (event) {
                const relatedLink = event.relatedTarget;
                
                const accordionContent = relatedLink.closest('.accordion-collapse');
                
                if (!accordionContent) {
                    carouselInner.innerHTML = '<p class="p-4 text-white">Brak danych galerii.</p>';
                    return;
                }

                const picturesJson = accordionContent.getAttribute('data-gallery-pictures');
                const slug = accordionContent.getAttribute('data-gallery-slug');
                const initialIndex = parseInt(relatedLink.getAttribute('data-index'));

                const pictures = JSON.parse(picturesJson);
                
                carouselInner.innerHTML = '';

                pictures.forEach((picture, index) => {
                    const isActive = index === initialIndex ? 'active' : '';
                    const imageUrl = `/uploads/galleries/${slug}/${picture.filename}`;
                    
                    const itemDiv = document.createElement('div');
                    itemDiv.className = `carousel-item text-center ${isActive}`;
                    
                    itemDiv.innerHTML = `
                        <img src="${imageUrl}" class="d-block w-auto mx-auto" alt="${slug} picture" style="max-height: 80vh;">
                    `;
                    
                    carouselInner.appendChild(itemDiv);
                });

                const carousel = new bootstrap.Carousel(imageCarousel, {
                    ride: false,
                    wrap: true 
                });
                
                carousel.to(initialIndex);
            });
        });
    </script>
{% endblock %}